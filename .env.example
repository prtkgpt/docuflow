# Neon PostgreSQL connection string
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://mypdfkitty.com

# Google OAuth (optional). When both are set, a "Continue with Google"
# button appears on /login and /signup. Leave blank to use email-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Master Admin allowlist for /master-admin (comma-separated emails)
ADMIN_EMAILS=

# Resend (transactional email + magic link sign-in). When set, /login and
# /signup default to magic-link auth. When unset, the app falls back to
# the legacy passwordless credentials provider.
RESEND_API_KEY=
EMAIL_FROM="MyPDFKitty <hello@mypdfkitty.com>"
EMAIL_REPLY_TO=hello@mypdfkitty.com
# Set to "true" to keep the legacy password-less credentials provider
# enabled even when Resend is configured (useful for local dev only).
ALLOW_PASSWORDLESS_SIGNIN=

# Google Analytics 4 — leave unset to use the production ID.
# Set to a different G-XXXXXXXXXX to override on staging/preview.
# Set to an empty string to disable analytics on that environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI
OPENAI_API_KEY=

# Stripe (optional - mock checkout used if missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan, per-interval Stripe price IDs (one Stripe Product per plan,
# two Prices each: monthly + annual recurring).
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
# AI credit pack one-time prices (mode=payment, not subscription)
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# File storage: "local" | "vercel-blob" | "s3"
UPLOAD_STORAGE_PROVIDER=local

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# S3-compatible
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
