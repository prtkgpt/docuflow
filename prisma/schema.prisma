generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  // One-time chat-question credits the user has purchased via AI credit packs.
  chatQuestionsCredits Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  files         File[]
  processed     ProcessedFile[]
  toolUsage     ToolUsage[]
  subscription  Subscription?
  aiRequests    AIRequest[]
  aiUsage       AIUsage[]
  planUsage     PlanUsage?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model File {
  id           String   @id @default(cuid())
  userId       String?
  originalName String
  storedName   String
  mimeType     String
  size         Int
  url          String
  status       String   @default("ready")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  processed ProcessedFile[]
  usage     ToolUsage[]
  ai        AIRequest[]
  chunks    PdfChunk[]
  summary   PdfSummary?
  aiUsage   AIUsage[]

  @@index([userId])
}

model ProcessedFile {
  id         String   @id @default(cuid())
  userId     String?
  fileId     String
  toolType   String
  outputUrl  String
  outputSize Int
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  file File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileId])
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String?
  toolType  String
  fileId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  plan                 String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String   @default("active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id          String   @id @default(cuid())
  userId      String?
  fileId      String?
  requestType String
  prompt      String   @db.Text
  response    String   @db.Text
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model BlogPost {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  description       String    @db.Text
  category          String    @default("PDF editing")
  body              String    @db.Text
  answer            String?   @db.Text
  primaryToolHref   String?
  primaryToolLabel  String?
  relatedToolSlugs  String?
  faqJson           String?   @db.Text
  published         Boolean   @default(false)
  publishedAt       DateTime?
  authorEmail       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// AI cost / metering primitives
// ---------------------------------------------------------------------------

// Cached extraction chunks for a PDF. We chunk once on first AI use, then
// reuse for every subsequent chat question — avoids re-extracting and
// re-tokenizing on every call.
model PdfChunk {
  id        String   @id @default(cuid())
  fileId    String
  index     Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, index])
  @@index([fileId])
}

// Cached summary so we don't re-bill OpenAI when the same PDF is summarized
// twice. Re-running with ?fresh=1 (future) bypasses the cache.
model PdfSummary {
  id            String   @id @default(cuid())
  fileId        String   @unique
  short         String   @db.Text
  bullets       String   @db.Text  // JSON array of strings
  takeaways     String   @db.Text
  actions       String   @db.Text
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Decimal  @default(0) @db.Decimal(12, 6)
  createdAt     DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// One row per AI call, used for admin cost dashboards and per-user
// rolling totals. AIRequest stays as the user-facing log; this is the
// finance ledger.
model AIUsage {
  id            String   @id @default(cuid())
  userId        String?
  fileId        String?
  featureType   String   // "summarize" | "chat"
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Decimal  @default(0) @db.Decimal(12, 6)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([fileId])
}

// Rolling monthly counters per user. Updated on every action; reset
// lazily when resetDate has passed (handled at write time).
model PlanUsage {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  plan                    String
  filesUsed               Int      @default(0)
  summariesUsed           Int      @default(0)
  chatQuestionsUsed       Int      @default(0)
  inputTokensUsed         Int      @default(0)
  outputTokensUsed        Int      @default(0)
  estimatedCostMonthCents Int      @default(0)
  resetDate               DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
